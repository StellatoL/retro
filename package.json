{
  "name": "dsh-retro",
  "version": "0.3.0",
  "description": "DeepSeek Harness 经验复盘插件：采集、提炼、人工审阅、经验沉淀与博客联动。",
  "type": "module",
  "main": "./dsh-retro/lib/index.js",
  "exports": {
    ".": "./dsh-retro/lib/index.js",
    "./client": "./dsh-retro/lib/client.js",
    "./cordis.patch.yml": "./dsh-retro/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["dsh-retro/lib", "dsh-retro/skills", "dsh-retro/cordis.patch.yml", "dsh-retro/README.md", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./dsh-retro/cordis.patch.yml" },
    "client": { "platform": "web", "inject": [] }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-host-webserver": { "optional": true } },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "js-yaml": "4.3.2"
  },
  "repository": { "type": "git", "url": "git+https://github.com/StellatoL/retro.git" },
  "homepage": "https://github.com/StellatoL/retro#readme",
  "bugs": { "url": "https://github.com/StellatoL/retro/issues" },
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "retro", "obsidian", "knowledge", "blog"]
}
