{
  "name": "dsh-retro",
  "version": "0.3.0",
  "private": true,
  "description": "dsh-retro 的兼容本地入口；正式分发清单位于仓库根目录。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": { "node": ">=22" },
  "scripts": { "test": "node ../scripts/test.mjs" },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-host-webserver": { "optional": true } },
  "repository": { "type": "git", "url": "git+https://github.com/StellatoL/retro.git", "directory": "dsh-retro" },
  "homepage": "https://github.com/StellatoL/retro#readme",
  "bugs": { "url": "https://github.com/StellatoL/retro/issues" },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "plugin",
    "retro",
    "obsidian",
    "knowledge",
    "blog",
    "web"
  ]
}
